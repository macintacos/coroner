<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>coroner timeline</title>
<style>{{.Theme}}{{.CSS}}</style>
</head>
<body data-source-colors="{{.SourceColors}}">
<header>
<h1 id="heading"></h1>
<p class="refs" id="refs"></p>
<p class="meta" id="meta"></p>
<button type="button" id="theme" aria-pressed="false">Dark theme</button>
</header>
<main>
<form id="filters">
<fieldset id="sources"><legend>Sources</legend></fieldset>
<fieldset id="tags"><legend>Tags</legend></fieldset>
<label class="search">Search text <input type="search" id="q"></label>
<fieldset class="range"><legend>Time</legend>
<label>Since <input type="datetime-local" step="1" id="since"></label>
<label>Until <input type="datetime-local" step="1" id="until"></label>
<button type="button" id="all-times">All times</button>
</fieldset>
<button type="button" id="export-png">Export PNG</button>
</form>
<div id="timeline"></div>
<section id="review" aria-label="Your comments">
<p id="author" hidden><span id="commenting-as"></span> <button type="button" id="change-name">Change name</button></p>
<form id="name-form" hidden><label>Your name <input type="text" id="your-name" autocomplete="name" required></label> <button type="submit">Save name</button> <button type="button" id="cancel-name">Cancel</button></form>
<p class="hint" id="drafts-status" aria-live="polite"></p>
<button type="button" id="export-annotations">Export annotations (.jsonl)</button>
<button type="button" id="clear-exported" hidden>Clear exported drafts</button>
</section>
<section id="detail" aria-live="polite"></section>
<section id="print"></section>
</main>
<noscript>This timeline needs JavaScript to show its events.</noscript>
<script type="application/json" id="coroner-data">{{.Export}}</script>
<script type="application/json" id="coroner-zone">{{.Zone}}</script>
<script>{{.Library}}</script>
<script>{{.Viewer}}</script>
</body>
</html>
