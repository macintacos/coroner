# Overlays: -t given more than once reads several timelines as one chronology on event list
# and timeline export. Every other command acts on one timeline.

exits 0 coroner timeline create mongo-failover
exits 0 coroner timeline create checkout-latency
exits 0 coroner event add 'Primary stepped down' --at 2026-09-10T14:02:00Z -t mongo-failover

# A write, or a read of one timeline, given two timelines exits 2, kind usage, and writes
# nothing.
exits 2 coroner event add 'Checkout p99 at 4 s' --at 2026-09-10T14:02:00Z -t mongo-failover -t checkout-latency --json
! stdout .
stderr '^\{"error":\{"kind":"usage",[^\n]+\}\}\n\z'
exits 2 coroner annotation add 'Checkout slows as the primary steps down' --kind comment -t mongo-failover -t checkout-latency --json
! stdout .
stderr '^\{"error":\{"kind":"usage",[^\n]+\}\}\n\z'
exits 2 coroner event edit 1 --text 'Primary stepped down: replSetStepDown' -t mongo-failover -t checkout-latency --json
! stdout .
stderr '^\{"error":\{"kind":"usage",[^\n]+\}\}\n\z'
exits 2 coroner event delete 1 -t mongo-failover -t checkout-latency --json
! stdout .
stderr '^\{"error":\{"kind":"usage",[^\n]+\}\}\n\z'
exits 2 coroner event view 1 -t mongo-failover -t checkout-latency --json
! stdout .
stderr '^\{"error":\{"kind":"usage",[^\n]+\}\}\n\z'
exits 2 coroner status -t mongo-failover -t checkout-latency --json
! stdout .
stderr '^\{"error":\{"kind":"usage",[^\n]+\}\}\n\z'
exits 0 coroner event list -t checkout-latency --json
jsonvalid stdout
stdout '"events":\[\]'
exits 0 coroner event list -t mongo-failover --json
jsonvalid stdout
stdout '"text":"Primary stepped down",'

# The same timeline named twice is one timeline.
exits 0 coroner event add 'Election won by db-3' --at 2026-09-10T14:03:00Z -t mongo-failover -t mongo-failover
stderr '^Added event #2 to timeline `mongo-failover` '
exits 0 coroner event add 'Checkout p99 at 4 s' --at 2026-09-10T14:03:00Z -t checkout-latency --source grafana
exits 0 coroner event add 'Checkout errors clear' --at 2026-09-10T14:05:00Z -t checkout-latency

# event list merges the timelines by occurred at, then timeline id, then seq: at 14:03,
# mongo-failover's #2 comes before checkout-latency's #1, the older timeline. json lists the
# selected timelines under timelines; jsonl leads with a timeline line for each.
exits 0 coroner event list -t mongo-failover -t checkout-latency --json
cmp stdout list.json
exits 0 coroner event list -t mongo-failover -t checkout-latency --format jsonl
cmp stdout list.jsonl

# --order desc reverses the merge, and --limit counts every timeline's matches.
exits 0 coroner event list -t mongo-failover -t checkout-latency --order desc --limit 1 --json
jsonvalid stdout
stdout '"text":"Checkout errors clear"'
stdout '"truncated":true,"total":4\}$'
stderr '1 of 4'

# A timeline's name and its id are one timeline.
exits 0 coroner event list -t checkout-latency -t 01a09862-b1c0-7000-8000-000000000002 --json
jsonvalid stdout
stdout '^\{"timelines":\[\{"id":"01a09862-b1c0-7000-8000-000000000002",[^{]*\],"events"'
stdout '"total":2\}$'

# An unknown timeline among several exits 3, kind timeline_not_found, naming it.
exits 3 coroner event list -t mongo-failover -t missing --json
! stdout .
stderr '^\{"error":\{"kind":"timeline_not_found","message":"[^\n]*missing[^\n]*\}\}\n\z'
-- list.json --
