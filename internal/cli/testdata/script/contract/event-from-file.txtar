# event add --from-file adds a JSONL file of canonical event records in one transaction: every
# record is checked first, and one bad record adds nothing. Records carry their own ids, so
# re-running a batch adds nothing. Ids come from CORONER_TEST_IDS and created at from the
# records, so whole documents are compared with the files below.

exits 0 coroner timeline create mongo-failover
exits 0 coroner timeline create checkout-latency
exits 0 coroner timeline use mongo-failover

# --dry-run prints the events it would add, with null seqs, and adds nothing. A header line,
# as an export starts with, is ignored.
exits 0 coroner event add --from-file batch.jsonl --dry-run --json
cmp stdout dry-run.json
exits 0 coroner event list --json
jsonvalid stdout
stdout '"total":0\}$'

# The batch is added, each event under the next seq, in the order of the file.
exits 0 coroner event add --from-file batch.jsonl --json
cmp stdout added.json

# Running the same batch again adds nothing and exits 0: every event is identical.
exits 0 coroner event add --from-file batch.jsonl --json
cmp stdout again.json
exits 0 coroner event list --json
stdout '"total":3\}$'

# - reads the records from stdin, and -q prints the id of each event in the batch.
stdin more.jsonl
exits 0 coroner event add --from-file - -q
cmp stdout more-ids.txt
! stderr .

# One record changed under a stored id exits 4, kind id_conflict, and adds nothing.
exits 4 coroner event add --from-file changed.jsonl --json
! stdout .
stderr '^\{"error":\{"kind":"id_conflict","message":"[^\n]*01a0a07c-0000-7000-8000-000000000102[^\n]*text[^\n]*","hint":"[^\n]+"\}\}\n\z'
exits 0 coroner event list --json
stdout '"total":4\}$'

# Invalid records exit 2, kind invalid_input, listing every bad line, and add nothing.
exits 2 coroner event add --from-file invalid.jsonl --json
! stdout .
stderr '^\{"error":\{"kind":"invalid_input","message":"2 lines [^\n]*line 2: [^\n]*line 3: [^\n]*","hint":"[^\n]+"\}\}\n\z'
exits 0 coroner event list --json
stdout '"total":4\}$'

# A record must carry its id: a generated one would add the event again on every retry.
exits 2 coroner event add --from-file null-id.jsonl --json
! stdout .
stderr '^\{"error":\{"kind":"invalid_input","message":"[^\n]*key \\"id\\" must not be null[^\n]*",[^\n]+\}\}\n\z'

# Every record must belong to the timeline -t, CORONER_TIMELINE or timeline use selects.
exits 2 coroner event add --from-file batch.jsonl -t checkout-latency --json
! stdout .
stderr '^\{"error":\{"kind":"invalid_input","message":"[^\n]*checkout-latency[^\n]*",[^\n]+\}\}\n\z'

# A record of another type is refused; coroner import reads those.
exits 2 coroner event add --from-file annotation.jsonl --json
! stdout .
stderr '^\{"error":\{"kind":"invalid_input","message":"[^\n]*coroner import[^\n]*",[^\n]+\}\}\n\z'

# A file with no event records is refused.
exits 2 coroner event add --from-file empty.jsonl --json
! stdout .
stderr '^\{"error":\{"kind":"invalid_input",[^\n]+\}\}\n\z'

# --from-file takes every field from its records, so event text or a field's flag exits 2.
exits 2 coroner event add 'Primary stepped down' --from-file batch.jsonl --json
! stdout .
stderr '^\{"error":\{"kind":"usage",[^\n]+\}\}\n\z'
exits 2 coroner event add --from-file batch.jsonl --source mongod --json
! stdout .
stderr '^\{"error":\{"kind":"usage",[^\n]+\}\}\n\z'
exits 0 coroner event list --json
stdout '"total":4\}$'

-- batch.jsonl --
