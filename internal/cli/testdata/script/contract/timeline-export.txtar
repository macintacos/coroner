# JSON and JSONL output and exit codes of timeline export. Ids come from CORONER_TEST_IDS,
# created at and exported at from CORONER_TEST_NOW, and coroner_version is (devel) in every
# test binary, which go test never stamps with a version, so whole documents are compared
# with the files below.

exits 0 coroner timeline create mongo-outage --title 'Mongo primary election' --ref INC-4821
exits 0 coroner timeline use mongo-outage
exits 0 coroner event add 'Pager fires for db-2' --at 2026-09-11T03:15:00Z --source pagerduty --tag phase:detect --url https://pd.example.com/i/1 --author julian
exits 0 coroner event add 'Primary stepped down' --at 2026-09-11T05:14:07+02:00 --source mongod --tag election --tag phase:detect --author julian
exits 0 coroner event add 'Replica set has no primary' --at 2026-09-11T03:14:07Z --ended 2026-09-11T03:16:30Z --approximate --source mongod --author julian
exits 0 coroner annotation add 'Paged the on-call DBA' --kind comment --author julian
exits 0 coroner annotation add 'rs.status() showed no primary' -e 3 --kind evidence --source mongod --author julian
exits 0 coroner annotation add 'Page acknowledged' -e 1 --kind comment --source pagerduty --author julian
exits 0 coroner timeline create other
exits 0 coroner event add 'Unrelated deploy' -t other --at 2026-09-11T03:00:00Z --source deployer --author julian

# json is the envelope: the timeline, the sources its records name, its events in the order
# they happened, and their annotations. Nothing of the other timeline is in it.
exits 0 coroner timeline export --format json
cmp stdout export.json
! stderr .

# jsonl is a header, the timeline, the annotations on the timeline, the sources by name, then
# each event followed by its annotations. Events 2 and 3 happened at the same instant, so seq
# orders them.
exits 0 coroner timeline export --format jsonl
cmp stdout export.jsonl
! stderr .

# A filter narrows the events. The annotations on events left out, and the sources nothing
# exported names, are left out too, and query records the filter.
exits 0 coroner timeline export -t mongo-outage --format jsonl --source mongod
cmp stdout filtered.jsonl

# Of the events from 03:14 up to 03:15, only event 2 has the tag phase:detect and text
# containing primary. query records each filter, and stderr echoes the bounds it resolved.
exits 0 coroner timeline export --json --since 2026-09-11T03:14:00Z --until 2026-09-11T03:15:00Z --tag phase:detect --contains primary
jsonvalid stdout
stdout '"since":"2026-09-11T03:14:00.000000000Z","until":"2026-09-11T03:15:00.000000000Z","sources":\[\],"tags":\["phase:detect"\],"contains":"primary",'
stdout '"seq":2,'
! stdout '"seq":[13],'
stderr '^Events since 2026-09-11T03:14:00Z\b.* until 2026-09-11T03:15:00Z\b'

# --order picks which end --limit keeps events from; exported events stay in the order they
# happened, and stderr says when the export was cut short.
exits 0 coroner timeline export --json --order desc
stdout '"seq":2,.*"seq":3,.*"seq":1,'
! stderr .
exits 0 coroner timeline export --json --order desc --limit 1
jsonvalid stdout
stdout '"limit":1,"order":"desc"\}'
stdout '"seq":1,'
! stdout '"seq":2,'
stderr '1 of 3'

# --format is required, only json, jsonl, md, mermaid, html and svg are exports, --group-by
# and --include-raw apply only to md, and --group-by takes source or tag: exit 2.
exits 2 coroner timeline export
! stdout .
exits 2 coroner timeline export --format text
! stdout .
exits 2 coroner timeline export --format json --group-by source
! stdout .
exits 2 coroner timeline export --format jsonl --include-raw
! stdout .
exits 2 coroner timeline export --format md --group-by kind
! stdout .

# A timeline that does not exist exits 3, kind timeline_not_found.
exits 3 coroner timeline export -t no-such --format json
! stdout .
stderr '^\{"error":\{"kind":"timeline_not_found",[^\n]+\}\}\n\z'

# With no timeline selected, export exits 2, kind timeline_required.
exits 0 coroner timeline use --clear
exits 2 coroner timeline export --format jsonl
! stdout .
stderr '^\{"error":\{"kind":"timeline_required",[^\n]+\}\}\n\z'

-- export.json --
