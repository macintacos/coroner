# JSON and JSONL output and exit codes of event list. Ids are UUIDv7 and differ per run, so
# they match by pattern; created at comes from CORONER_TEST_NOW.

exits 0 coroner timeline create mongo-outage
exits 0 coroner timeline use mongo-outage
exits 0 coroner event add 'Primary stepped down' --at 2026-09-11T03:14:07.412Z --source mongod --tag election
exits 0 coroner event add 'Pager fires for db-2' --at 2026-09-11T03:15:00Z

# json wraps the events, each the event object event add prints, with truncated and total.
exits 0 coroner event list --json
stdout '^\{"events":\[\{"id":"[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[0-9a-f]{4}-[0-9a-f]{12}","timeline_id":"[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[0-9a-f]{4}-[0-9a-f]{12}","seq":1,"occurred_at":"2026-09-11T03:14:07\.412000000Z","occurred_offset":null,"precision":"millisecond","approximate":false,"occurred_raw":"2026-09-11T03:14:07\.412Z","ended_at":null,"source":"mongod","tags":\["election"\],"text":"Primary stepped down","url":null,"author":null,"created_at":"2026-09-13T01:30:00\.000000000Z","updated_at":"2026-09-13T01:30:00\.000000000Z"\},\{[^{}]*"seq":2,[^{}]*\}\],"truncated":false,"total":2\}$'

# A limit that leaves events out sets truncated and says so on stderr.
exits 0 coroner event list --limit 1 --json
stdout '\],"truncated":true,"total":2\}$'
stderr '1 of 2'

# No match is an empty list, not an error.
exits 0 coroner event list --tag no-such-tag --json
stdout '^\{"events":\[\],"truncated":false,"total":0\}$'

# jsonl prints one event object per line, with type first.
exits 0 coroner event list --format jsonl
stdout -count=2 '^\{"type":"event","id":"[0-9a-f-]{36}","timeline_id":"[0-9a-f-]{36}","seq":[12],"occurred_at":"[^"]+",[^\n]*,"updated_at":"[^"]+"\}$'

# A filter no event could match exits 2 before reading anything: usage, invalid_name,
# invalid_time.
exits 2 coroner event list --order newest --json
! stdout .
stderr '^\{"error":\{"kind":"usage",[^\n]+\}\}\n\z'
exits 2 coroner event list --source 'DB 2' --json
stderr '^\{"error":\{"kind":"invalid_name",[^\n]+\}\}\n\z'
exits 2 coroner event list --since 'the day before' --json
stderr '^\{"error":\{"kind":"invalid_time",[^\n]+\}\}\n\z'

# With no timeline selected, list exits 2, kind timeline_required.
exits 0 coroner timeline use --clear
exits 2 coroner event list --json
stderr '^\{"error":\{"kind":"timeline_required",[^\n]+\}\}\n\z'
