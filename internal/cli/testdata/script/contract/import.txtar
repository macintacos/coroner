# import's result object and exit codes, and the round trip it promises: an export imported into
# an empty database exports again byte for byte. Each section sets the database it uses.

# A timeline with every record type, exported with its attachment files beside it.
env CORONER_DB=$WORK/source.db
exits 0 coroner timeline create inc-4821 --title 'Mongo primary election' --ref INC-4821
exits 0 coroner timeline use inc-4821
exits 0 coroner event add 'Primary stepped down' --at 2026-09-11T05:14:07+02:00 --source mongod --tag election --author julian --attach stepdown.log
exits 0 coroner event add 'Pager fires for db-2' --at 2026-09-11T03:15:00Z --source pagerduty
exits 0 coroner annotation add 'rs.status() showed no primary' -e 1 --kind evidence --source mongod --attach rs-status.json
exits 0 coroner annotation add 'Paged the on-call DBA' --kind comment --author julian
exits 0 coroner timeline export --format jsonl -o $WORK/out/
exits 0 coroner timeline export --format jsonl
cp stdout original.jsonl

# --dry-run reports what the import would do, exits as it would, and writes nothing, not even a
# new database: -t then names no timeline.
env CORONER_DB=$WORK/copy.db
exits 0 coroner import $WORK/out/inc-4821.jsonl --dry-run --json
cmp stdout dry-run.json
stderr '^Would import into timeline `inc-4821`$'
stderr '^Would import timelines: 1 inserted, 0 identical, 0 conflicting$'
exits 3 coroner import $WORK/out/inc-4821.jsonl --dry-run -t inc-4821 --json
stderr '^\{"error":\{"kind":"timeline_not_found",[^\n]+\}\}\n\z'
! exists $WORK/copy.db
exits 0 coroner timeline list --json
stdout '"timelines":\[\]'

# Into an empty database the import recreates the timeline exactly: authors, created and updated
# ats, seqs and attachments, so its export is the original's bytes.
exits 0 coroner import $WORK/out/inc-4821.jsonl --json
cmp stdout imported.json
stderr '^Imported events: 2 inserted, 0 identical, 0 conflicting$'
exits 0 coroner timeline export -t inc-4821 --format jsonl
cmp stdout original.jsonl

# Importing the same file again changes nothing and exits 0.
exits 0 coroner import $WORK/out/inc-4821.jsonl --json
cmp stdout reimported.json

# -t guards the import: it must name a stored timeline, which every record belongs to.
exits 0 coroner import $WORK/out/inc-4821.jsonl -t inc-4821
exits 3 coroner import $WORK/out/inc-4821.jsonl -t no-such-timeline --json
stderr '^\{"error":\{"kind":"timeline_not_found",[^\n]+\}\}\n\z'
exits 0 coroner timeline create elsewhere
exits 2 coroner import $WORK/out/inc-4821.jsonl -t elsewhere --json
! stdout .
stderr '^\{"error":\{"kind":"invalid_input",[^\n]+\}\}\n\z'

# A record changed since the import conflicts: exit 4 and nothing written by default, and --json
# lists each conflicting record with the keys that differ.
env CORONER_DB=$WORK/source.db
exits 0 coroner event edit 2 --text 'Pager fires for db-2 and db-3'
exits 0 coroner timeline export --format jsonl -o $WORK/edited/
env CORONER_DB=$WORK/copy.db
exits 4 coroner import $WORK/edited/inc-4821.jsonl --json
cmp stdout conflict.json
stderr '^\{"error":\{"kind":"id_conflict","message":"[^\n]+","hint":"[^\n]+"\}\}\n\z'
exits 0 coroner event view 2 -t inc-4821 --json
stdout '"text":"Pager fires for db-2",'
exits 4 coroner import $WORK/edited/inc-4821.jsonl --dry-run --json
cmp stdout conflict-dry-run.json

# --on-conflict skip keeps the stored record; replace takes the import's.
exits 0 coroner import $WORK/edited/inc-4821.jsonl --on-conflict skip
exits 0 coroner event view 2 -t inc-4821 --json
stdout '"text":"Pager fires for db-2",'
exits 0 coroner import $WORK/edited/inc-4821.jsonl --on-conflict replace
exits 0 coroner event view 2 -t inc-4821 --json
stdout '"text":"Pager fires for db-2 and db-3",'
exits 2 coroner import $WORK/edited/inc-4821.jsonl --on-conflict merge --json
stderr '^\{"error":\{"kind":"usage",[^\n]+\}\}\n\z'

# A timeline record whose name another stored timeline holds exits 4, kind timeline_exists.
env CORONER_DB=$WORK/clash.db
exits 0 coroner timeline create inc-4821
exits 4 coroner import $WORK/out/inc-4821.jsonl --json
stderr '^\{"error":\{"kind":"timeline_exists","message":"[^\n]+","hint":"[^\n]+"\}\}\n\z'

# Concatenated exports import from stdin, repeated headers and all.
env CORONER_DB=$WORK/source.db
exits 0 coroner timeline create inc-4822
exits 0 coroner event add 'Checkout p99 alert' -t inc-4822 --at 2026-09-11T04:00:00Z --source grafana
exits 0 coroner timeline create inc-4823
exits 0 coroner event add 'Checkout p99 recovers' -t inc-4823 --at 2026-09-11T04:20:00Z --source grafana
exits 0 coroner timeline export -t inc-4822 --format jsonl
cp stdout inc-4822.jsonl
exits 0 coroner timeline export -t inc-4823 --format jsonl
cp stdout inc-4823.jsonl
exec cat inc-4822.jsonl inc-4823.jsonl
cp stdout both.jsonl
env CORONER_DB=$WORK/concat.db
stdin both.jsonl
exits 0 coroner import - --json
jsonvalid stdout
stdout '"timelines":\{"inserted":2,"identical":0,"conflicting":0\}'
stdout '"sources":\{"inserted":1,"identical":0,"conflicting":0\}'

# An export without its attachment files imports everything else, and lists the attachments it
# skipped: their files are neither beside it nor in the database.
env CORONER_DB=$WORK/bare.db
exits 0 coroner import original.jsonl --json
cmp stdout missing-attachments.json
stderr '^Left out 2 attachments '

# Keys and record types this coroner does not know are ignored.
env CORONER_DB=$WORK/compat.db
exits 0 coroner import later-minor.jsonl --json
jsonvalid stdout
stdout '"events":\{"inserted":1,"identical":0,"conflicting":0\}'

# Invalid input exits 2, kind invalid_input, and writes nothing: an unsupported major version, a
# line that is not a valid record, and a reference to a timeline neither the file nor the
# database holds.
exits 2 coroner import major-2.jsonl --json
! stdout .
stderr '"2\.0"'
stderr '^\{"error":\{"kind":"invalid_input","message":"[^\n]+","hint":"[^\n]+"\}\}\n\z'
exits 2 coroner import invalid-line.jsonl --json
stderr '^Error: 1 line is not a valid export record:'
stderr '^\{"error":\{"kind":"invalid_input",[^\n]+\}\}\n\z'
exits 2 coroner import dangling.jsonl --json
stderr '^Error: 1 record cannot be imported:'
stderr '^\{"error":\{"kind":"invalid_input",[^\n]+\}\}\n\z'
exits 0 coroner timeline list --json
stdout '"name":"later-minor"'
! stdout '"name":"invalid-line"'

-- stepdown.log --
