# How a timeline-scoped command selects its timeline: -t, then CORONER_TIMELINE, then
# 'coroner timeline use'. A layer naming a missing timeline never falls through.

exits 0 coroner timeline create first
exits 0 coroner timeline create second
exits 0 coroner timeline create third

# With nothing selected, exit 2, kind timeline_required, with a hint naming every layer.
exits 2 coroner timeline view --json
! stdout .
stderr '^\{"error":\{"kind":"timeline_required","message":"[^\n]+","hint":"[^\n]*-t[^\n]*CORONER_TIMELINE[^\n]*coroner timeline use[^\n]*"\}\}\n\z'

# CORONER_TIMELINE wins over the timeline in use.
exits 0 coroner timeline use first
env CORONER_TIMELINE=second
exits 0 coroner timeline view --json
jsonvalid stdout
stdout '"name":"second"'

# -t wins over CORONER_TIMELINE.
exits 0 coroner timeline view -t third --json
jsonvalid stdout
stdout '"name":"third"'

# A missing timeline named by CORONER_TIMELINE or -t exits 3, kind timeline_not_found.
env CORONER_TIMELINE=missing
exits 3 coroner timeline view --json
! stdout .
stderr '^\{"error":\{"kind":"timeline_not_found",[^\n]+\}\}\n\z'
env CORONER_TIMELINE=
exits 3 coroner timeline view -t missing --json
! stdout .
stderr '^\{"error":\{"kind":"timeline_not_found",[^\n]+\}\}\n\z'

# An empty CORONER_TIMELINE counts as unset.
exits 0 coroner timeline view --json
jsonvalid stdout
stdout '"name":"first"'

# event add selects its timeline the same way: CORONER_TIMELINE over the timeline in use, -t
# over both, and a missing timeline exits 3.
env CORONER_TIMELINE=second
exits 0 coroner event add 'Primary stepped down' --at 2026-09-11T03:14:07Z
stderr '^Added event #1 to timeline `second` '
exits 0 coroner event add 'Primary stepped down' --at 2026-09-11T03:14:07Z -t third
stderr '^Added event #1 to timeline `third` '
exits 3 coroner event add 'Primary stepped down' --at 2026-09-11T03:14:07Z -t missing --json
! stdout .
stderr '^\{"error":\{"kind":"timeline_not_found",[^\n]+\}\}\n\z'
