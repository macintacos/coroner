-- coroner_annotation_edit.txt --
Change an annotation's body, kind, source or URL. Its author, event and timeline never
change. <id> is a full id or a unique id prefix, in any timeline. --body - reads the body
from stdin, which loses one trailing newline. --attach adds a file to the annotation's
attachments; 'coroner attachment delete' removes one.

USAGE
  coroner annotation edit <id> [flags]

EXAMPLES
  $ coroner annotation edit 0199a1b2-7c1e --kind comment
  $ coroner annotation edit 0199a1b2-7c1e --attach ./stepdown-trace.pdf
  $ coroner annotation edit 0199a1b2-7c1e --body - --dry-run --json < stepdown.log

FLAGS
      --attach file     Copy this file in as an attachment; repeat for more
      --body body       New body, or - to read it from stdin
      --dry-run         Show the edited annotation, and change nothing
      --kind kind       New annotation kind: {evidence | comment}
      --source source   New source, created on first use, or none
      --url url         New permalink, as a url, or none

GLOBAL FLAGS
      --config path     Config file path (env: CORONER_CONFIG)
      --db path         Database file path (env: CORONER_DB)
      --debug           Print debug detail on stderr (env: CORONER_DEBUG)
      --format format   Output format: {text | json | jsonl}, and more on timeline export (default "text")
  -h, --help            Show help for a command
      --json            Short for --format json
      --no-color        Disable color (env: NO_COLOR, CORONER_NO_COLOR)
      --no-input        Never open a form, picker or viewer (env: CORONER_NO_INPUT)
  -q, --quiet           Print only essential output
      --tz zone         Time zone for this invocation (default: config default_timezone, then TZ)

