# --help output of every command, and the exit codes of help <topic>. --help pins each
# command's usage, flags and examples: a wording change regenerates it with -update and is
# not a breaking change, while a removed or renamed command or flag is. Topic bodies are
# human text, pinned outside the contract in help-topics.txtar.

# --help prints usage to stdout and exits 0.
exits 0 coroner --help
cmp stdout coroner.txt
! stderr .

# Every other command, in tree order.
exits 0 coroner agent --help
cmp stdout coroner_agent.txt
! stderr .

exits 0 coroner agent skill --help
cmp stdout coroner_agent_skill.txt
! stderr .

exits 0 coroner annotation --help
cmp stdout coroner_annotation.txt
! stderr .

exits 0 coroner annotation add --help
cmp stdout coroner_annotation_add.txt
! stderr .

exits 0 coroner annotation delete --help
cmp stdout coroner_annotation_delete.txt
! stderr .

exits 0 coroner annotation edit --help
cmp stdout coroner_annotation_edit.txt
! stderr .

exits 0 coroner annotation list --help
cmp stdout coroner_annotation_list.txt
! stderr .

exits 0 coroner attachment --help
cmp stdout coroner_attachment.txt
! stderr .

exits 0 coroner attachment delete --help
cmp stdout coroner_attachment_delete.txt
! stderr .

exits 0 coroner attachment export --help
cmp stdout coroner_attachment_export.txt
! stderr .

exits 0 coroner attachment list --help
cmp stdout coroner_attachment_list.txt
! stderr .

exits 0 coroner completion --help
cmp stdout coroner_completion.txt
! stderr .

exits 0 coroner completion bash --help
cmp stdout coroner_completion_bash.txt
! stderr .

exits 0 coroner completion fish --help
cmp stdout coroner_completion_fish.txt
! stderr .

exits 0 coroner completion powershell --help
cmp stdout coroner_completion_powershell.txt
! stderr .

exits 0 coroner completion zsh --help
cmp stdout coroner_completion_zsh.txt
! stderr .

exits 0 coroner event --help
cmp stdout coroner_event.txt
! stderr .

exits 0 coroner event add --help
cmp stdout coroner_event_add.txt
! stderr .

exits 0 coroner event delete --help
cmp stdout coroner_event_delete.txt
! stderr .

exits 0 coroner event edit --help
cmp stdout coroner_event_edit.txt
! stderr .

exits 0 coroner event link --help
cmp stdout coroner_event_link.txt
! stderr .

exits 0 coroner event list --help
cmp stdout coroner_event_list.txt
! stderr .

exits 0 coroner event unlink --help
cmp stdout coroner_event_unlink.txt
! stderr .

exits 0 coroner event view --help
cmp stdout coroner_event_view.txt
! stderr .

exits 0 coroner help --help
cmp stdout coroner_help.txt
! stderr .

exits 0 coroner import --help
cmp stdout coroner_import.txt
! stderr .

exits 0 coroner overlay --help
cmp stdout coroner_overlay.txt
! stderr .

exits 0 coroner overlay create --help
cmp stdout coroner_overlay_create.txt
! stderr .

exits 0 coroner source --help
cmp stdout coroner_source.txt
! stderr .

exits 0 coroner source edit --help
cmp stdout coroner_source_edit.txt
! stderr .

exits 0 coroner source list --help
cmp stdout coroner_source_list.txt
! stderr .

exits 0 coroner status --help
cmp stdout coroner_status.txt
! stderr .

exits 0 coroner tag --help
cmp stdout coroner_tag.txt
! stderr .

exits 0 coroner tag list --help
cmp stdout coroner_tag_list.txt
! stderr .

exits 0 coroner timeline --help
cmp stdout coroner_timeline.txt
! stderr .

exits 0 coroner timeline create --help
cmp stdout coroner_timeline_create.txt
! stderr .

exits 0 coroner timeline delete --help
cmp stdout coroner_timeline_delete.txt
! stderr .

exits 0 coroner timeline edit --help
cmp stdout coroner_timeline_edit.txt
