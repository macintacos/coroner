# The export fixtures in testdata/export/v<format_version>/, each written by a real timeline
# export. internal/export's fixture suite validates, decodes and re-encodes every fixture.
# Each section starts its own database, ID counter and clock, so no fixture's bytes depend on
# another section.

# minimal: one timeline with no title, refs or events.
env CORONER_DB=$WORK/minimal.db
env CORONER_TEST_IDS=$WORK/minimal.ids
env CORONER_TEST_NOW=2026-09-12T21:30:00-04:00
exits 0 coroner timeline create minimal
exits 0 coroner timeline export -t minimal --format jsonl
exportfixture minimal.jsonl stdout

# full-model: every record type, and events with every precision, an approximate interval, a
# null and a non-null offset, no source or author, several tags, a url, and a later edit.
env CORONER_DB=$WORK/full-model.db
env CORONER_TEST_IDS=$WORK/full-model.ids
env CORONER_TEST_NOW=2026-09-12T21:30:00-04:00
exits 0 coroner timeline create full-model --title 'Mongo primary election' --ref INC-4821 --ref https://tracker.example.com/INC-4821
exits 0 coroner timeline use full-model
exits 0 coroner event add 'Maintenance window opens' --at 2026-09-11 --tz UTC --source change-calendar --tag phase:context --author julian
# Natural language is the only input with hour precision.
exits 0 coroner event add 'Nightly backup starts' --at '2026-09-11 3am' --tz UTC --source cron --author julian
exits 0 coroner event add 'Oplog window drops under an hour' --at 2026-09-11T03:10 --tz UTC --source grafana --author julian
exits 0 coroner event add 'Primary stepped down' --at 2026-09-11T05:14:07+02:00 --source mongod --tag election --tag phase:detect --tag severity:high --url https://logs.example.com/l/81723 --author julian
exits 0 coroner event add 'Election timeout on db-3' --at 2026-09-11T03:14:07.412Z --source mongod --author julian
exits 0 coroner event add 'Driver saw NotWritablePrimary' --at 2026-09-11T03:14:07.412123Z --source api --author julian
exits 0 coroner event add 'db-2 elected primary' --at 1789096448123456789 --source mongod --author julian
exits 0 coroner event add 'Replica set has no primary' --at '~2026-09-11T03:14:00Z' --ended 2026-09-11T03:16:30Z
exits 0 coroner annotation add 'rs.status() showed no primary' -e 8 --kind evidence --source mongod --url https://logs.example.com/l/81730 --author julian
exits 0 coroner annotation add 'Step-down follows the oplog alert by four minutes' -e 4 --kind comment --author julian
env CORONER_TEST_NOW=2026-09-12T22:05:00-04:00
exits 0 coroner event edit 4 --add-tag root-cause
exits 0 coroner timeline export --format jsonl
exportfixture full-model.jsonl stdout
exits 0 coroner timeline export --format json
exportfixture full-model.json stdout

# annotations: evidence and comments on events, several on one event at different times, and
# one on the whole timeline.
env CORONER_DB=$WORK/annotations.db
env CORONER_TEST_IDS=$WORK/annotations.ids
env CORONER_TEST_NOW=2026-09-12T21:30:00-04:00
exits 0 coroner timeline create annotations
exits 0 coroner timeline use annotations
exits 0 coroner event add 'Pager fires for db-2' --at 2026-09-11T03:15:00Z --source pagerduty --author julian
exits 0 coroner event add 'Primary stepped down' --at 2026-09-11T03:14:07Z --source mongod --author julian
exits 0 coroner annotation add 'Paged the on-call DBA' --kind comment --author julian
exits 0 coroner annotation add 'replSetStepDown in the mongod log' -e 2 --kind evidence --source mongod --author julian
env CORONER_TEST_NOW=2026-09-12T21:40:00-04:00
exits 0 coroner annotation add 'Page acknowledged' -e 1 --kind comment --source pagerduty
exits 0 coroner annotation add 'The step-down was not planned' -e 2 --kind comment --author julian
env CORONER_TEST_NOW=2026-09-12T21:50:00-04:00
exits 0 coroner annotation add 'Incident channel opened' --kind evidence --source slack --url https://slack.example.com/archives/C1/p1
exits 0 coroner timeline export --format jsonl
exportfixture annotations.jsonl stdout

# ordering: events added out of time order, three at the same instant, so occurred at and then
# seq order them. The second of the three is added under an earlier clock, so its id sorts
# before the first's while its seq is higher. The minute-precision event sorts at the start of
# its minute.
env CORONER_DB=$WORK/ordering.db
env CORONER_TEST_IDS=$WORK/ordering.ids
env CORONER_TEST_NOW=2026-09-12T21:30:00-04:00
exits 0 coroner timeline create ordering
exits 0 coroner timeline use ordering
exits 0 coroner event add 'Pager fires' --at 2026-09-11T03:15:00Z --source pagerduty
exits 0 coroner event add 'First of three at 03:14:07' --at 2026-09-11T03:14:07Z --source mongod
env CORONER_TEST_NOW=2026-09-12T21:20:00-04:00
exits 0 coroner event add 'Second of three at 03:14:07' --at 2026-09-11T03:14:07Z --source mongod
env CORONER_TEST_NOW=2026-09-12T21:30:00-04:00
exits 0 coroner event add 'Third of three at 03:14:07' --at 2026-09-11T03:14:07Z --source api
exits 0 coroner event add 'Sometime in minute 03:14' --at 2026-09-11T03:14 --tz UTC --source grafana
exits 0 coroner timeline export --format jsonl
exportfixture ordering.jsonl stdout

# hostile-text: multi-line text, backticks, </script>, <, > and &, non-ASCII, and a 10 KB
# single log line kept verbatim as evidence.
env CORONER_DB=$WORK/hostile-text.db
env CORONER_TEST_IDS=$WORK/hostile-text.ids
env CORONER_TEST_NOW=2026-09-12T21:30:00-04:00
exits 0 coroner timeline create hostile-text --title 'Réplica caída — 東京 ✓'
exits 0 coroner timeline use hostile-text
stdin event-text.txt
exits 0 coroner event add - --at 2026-09-11T03:14:07Z --source db-2/mongod --tag 'phase:detect'
stdin comment.md
exits 0 coroner annotation add - -e 1 --kind comment
stdin mongod.log
exits 0 coroner annotation add - -e 1 --kind evidence --source db-2/mongod
exits 0 coroner timeline export --format jsonl
exportfixture hostile-text.jsonl stdout

# concatenated: two exports back to back, as cat a.jsonl b.jsonl makes, so header and source
# records repeat.
env CORONER_DB=$WORK/concatenated.db
env CORONER_TEST_IDS=$WORK/concatenated.ids
env CORONER_TEST_NOW=2026-09-12T21:30:00-04:00
exits 0 coroner timeline create concat-db
exits 0 coroner timeline create concat-api
exits 0 coroner event add 'Pager fires for db-2' -t concat-db --at 2026-09-11T03:15:00Z --source pagerduty
exits 0 coroner event add 'Pager fires for api' -t concat-api --at 2026-09-11T03:16:00Z --source pagerduty
exits 0 coroner timeline export -t concat-db --format jsonl
cp stdout concat-db.jsonl
exits 0 coroner timeline export -t concat-api --format jsonl
exportfixture concatenated.jsonl concat-db.jsonl stdout

-- event-text.txt --
Primary stepped down after `rs.stepDown()`:
  the status page embedded </script><script>alert(1)</script> & <b>kept</b> rendering.
Région eu-west → 東京 fallback, “quoted”, naïve café ✓
-- comment.md --
Check `db.getSiblingDB("local").oplog.rs.stats()` first:

```js
if (window < 3600 && lag > 10) { stepDown(); }
```

