# JSON output and exit codes of --attach and the attachment commands. Ids come from
# CORONER_TEST_IDS and created at from CORONER_TEST_NOW. A stored attachment's path is under
# $WORK, so documents that hold one are compared with cmpenv. Each file's sha256 is its
# shasum -a 256.

# A file --attach cannot read exits 2, kind usage, before the database or blob directory exists.
exits 2 coroner event add 'Dashboard at peak' -t mongo-outage --attach missing.gif --json
! stdout .
stderr '^\{"error":\{"kind":"usage","message":"[^\n]*missing\.gif[^\n]*","hint":"[^\n]+"\}\}\n\z'
! exists $WORK/.local/share/coroner

# --attach - exits 2, kind usage: stdin is not an attachment yet.
exits 2 coroner event add 'Dashboard at peak' -t mongo-outage --attach - --json
! stdout .
stderr '^\{"error":\{"kind":"usage","message":"[^\n]+","hint":"[^\n]+"\}\}\n\z'
! exists $WORK/.local/share/coroner

exits 0 coroner timeline create mongo-outage
exits 0 coroner timeline use mongo-outage

# --dry-run describes each file with a null id and path, and copies nothing.
exits 0 coroner event add 'Dashboard at peak' --at 2026-09-11T03:14:07Z --attach panel.gif --dry-run --json
cmp stdout dry-run.json
! exists $WORK/.local/share/coroner/blobs/dae30e4c7e71f01d984dc91c4d8304562a55f9bf1c1b449fa34152c1c72a88df

# add copies each file into the blob directory and prints the event with an object per file.
exits 0 coroner event add 'Dashboard at peak' --at 2026-09-11T03:14:07Z --attach dashboard.gif --attach trace.pdf --json
cmpenv stdout added.json
cmp $WORK/.local/share/coroner/blobs/590eb48d293a85848b9970589aea931ddff39f54b763d7b77e603d8a9b97e22b dashboard.gif
cmp $WORK/.local/share/coroner/blobs/de82e0a72e7b28381bdffd0d28f2f5dfb57cb5f78c654f69455aac70ab969923 trace.pdf

# The event's other objects carry the same attachments.
exits 0 coroner event view 1 --json
cmpenv stdout added.json

# annotation add --attach attaches to the annotation; identical content shares the event's blob.
exits 0 coroner annotation add 'Grafana panel at peak' -e 1 --kind evidence --attach dashboard.gif --json
cmpenv stdout annotation-added.json

# Lists and delete --dry-run give each event and annotation only its own attachments.
exits 0 coroner event list --json
cmpenv stdout event-list.json
exits 0 coroner event list --format jsonl
cmpenv stdout event-list.jsonl
exits 0 coroner event delete 1 --dry-run --json
cmpenv stdout event-list.json
exits 0 coroner annotation list --json
cmpenv stdout annotation-list.json
exits 0 coroner annotation delete 0 --dry-run --json
cmpenv stdout annotation-list.json

# edit --attach adds to what the event or annotation already has.
exits 0 coroner event edit 1 --attach panel.gif --json
jsonvalid stdout
stdout '"filename":"dashboard\.gif",.*"filename":"trace\.pdf",.*"filename":"panel\.gif",'
exits 0 coroner annotation edit 0 --attach trace.pdf --json
jsonvalid stdout
stdout '"attachments":\[\{[^\]]*"filename":"dashboard\.gif",[^\]]*"filename":"trace\.pdf",'

# list prints every attachment on the timeline's events and annotations; -e only an event's own.
exits 0 coroner attachment list --json
jsonvalid stdout
stdout '\A\{"attachments":\[(\{[^{}]*\},?){5}\],"truncated":false,"total":5\}\n\z'
exits 0 coroner attachment list -e 1 --json
cmpenv stdout event-attachments.json

# export writes the file byte for byte, to stdout by default, and never overwrites a file without
# --force: an existing -o exits 4.
exits 0 coroner attachment export 01a09862-b1c0-7000-8000-000000000005 -o exported.pdf
cmp exported.pdf trace.pdf
exits 4 coroner attachment export 01a09862-b1c0-7000-8000-000000000004 -o exported.pdf
cmp exported.pdf trace.pdf
exits 0 coroner attachment export 01a09862-b1c0-7000-8000-000000000004 -o exported.pdf --force
cmp exported.pdf dashboard.gif
exits 0 coroner attachment export 01a09862-b1c0-7000-8000-000000000004
cmp stdout dashboard.gif

# An id no attachment has exits 3, kind attachment_not_found.
exits 3 coroner attachment delete 01a09862-b1c0-7000-8000-000000000099 --json
! stdout .
stderr '^\{"error":\{"kind":"attachment_not_found","message":"[^\n]+","hint":"[^\n]+"\}\}\n\z'

# delete --dry-run prints the objects it would delete, and deletes nothing; delete prints them.
exits 0 coroner attachment delete 01a09862-b1c0-7000-8000-000000000009 --dry-run --json
cmpenv stdout deleted.json
exits 0 coroner attachment delete 01a09862-b1c0-7000-8000-000000000009 --json
cmpenv stdout deleted.json
exits 3 coroner attachment export 01a09862-b1c0-7000-8000-000000000009 -o deleted.gif
! exists deleted.gif

# edit --dry-run lists the stored attachments, then describes each file with a null id and path.
exits 0 coroner event edit 1 --attach panel.gif --dry-run --json
cmpenv stdout edit-dry-run.json

-- dashboard.gif --
GIF89a dashboard at peak
-- trace.pdf --
%PDF-1.7 election trace
-- panel.gif --
GIF89a p99 latency panel
-- dry-run.json --
