# Each exit code a command line can reach, with its kind in the stderr JSON error
# envelope. Nothing reaches 1 (internal) or 130 (interrupted) from a script yet;
# cli.Run's specs pin those. No command raises id_conflict yet. version's field is
# experimental until 1.0 and holds the build's version, so a pattern matches it.

# 0: success. stdout is valid JSON and stderr is empty.
exits 0 coroner version --format json
jsonvalid stdout
stdout '^\{"coroner_version":"[^"]*"\}$'
! stderr .

# 2, usage: an unknown command. The envelope is the last line of stderr.
exits 2 coroner --format json versio
! stdout .
stderr 'Did you mean this\?'
stderr '^\{"error":\{"kind":"usage","message":"[^\n]+","hint":"[^\n]+"\}\}\n\z'

# 2, usage: an unknown flag.
exits 2 coroner version --no-such-flag --format jsonl
! stdout .
stderr '^\{"error":\{"kind":"usage","message":"[^\n]*--no-such-flag[^\n]*","hint":[^\n]+\}\}\n\z'

# 2, usage: --json with a conflicting --format.
exits 2 coroner --json --format text version
! stdout .
stderr '^\{"error":\{"kind":"usage",[^\n]+\}\}\n\z'

# 2, usage: a format the command cannot print.
exits 2 coroner version --format jsonl
! stdout .
stderr '^\{"error":\{"kind":"usage",[^\n]+\}\}\n\z'

# In text mode the same failure prints no JSON.
exits 2 coroner versio
! stdout .
! stderr '\{'

# 5, db_too_new: a database a newer coroner migrated.
exits 0 coroner timeline create future --db $WORK/new.db
bumpschema $WORK/new.db
exits 5 coroner timeline list --db $WORK/new.db --json
! stdout .
stderr '^\{"error":\{"kind":"db_too_new","message":"[^\n]+","hint":"[^\n]+"\}\}\n\z'

# 5, db_unreadable: --db names a directory, whether the command writes or only reads.
mkdir $WORK/dir
exits 5 coroner timeline create outage --db $WORK/dir --json
! stdout .
stderr '^\{"error":\{"kind":"db_unreadable","message":"[^\n]+","hint":"[^\n]+"\}\}\n\z'
exits 5 coroner status --db $WORK/dir --json
! stdout .
stderr '^\{"error":\{"kind":"db_unreadable",[^\n]+\}\}\n\z'
