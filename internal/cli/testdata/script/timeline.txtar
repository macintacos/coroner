# A command line rejected before it reaches the database never creates one.
exits 2 coroner timeline create 'Mongo Outage'
stderr 'Did you mean `mongo-outage`\?'
exits 2 coroner timeline craete mongo-outage
stderr 'Did you mean this\?'
exits 2 coroner timeline delete mongo-outage
stderr '--yes'
exits 2 coroner timeline edit mongo-outage
exits 2 coroner timeline use
! exists $WORK/.local/share/coroner

# Create a timeline, use it, and see it marked in the list.
exec coroner timeline create mongo-outage-2026-09-11 --title 'Primary election storm' --ref INC-4821
! stdout .
stderr '^Next: coroner timeline use mongo-outage-2026-09-11$'
exec coroner timeline use mongo-outage-2026-09-11
exec coroner timeline list
stdout '^\* mongo-outage-2026-09-11\tPrimary election storm$'
exec coroner timeline view
stdout '^mongo-outage-2026-09-11$'
stdout '^Refs: +INC-4821$'

# --dry-run deletes nothing; deleting the current timeline leaves none current.
exec coroner timeline delete mongo-outage-2026-09-11 --dry-run
stdout '0 events, 0 annotations'
exec coroner timeline delete mongo-outage-2026-09-11 --yes
exec coroner timeline list
! stdout .
exits 2 coroner timeline view
