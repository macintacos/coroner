# A command line rejected before it reaches the database never creates one.
exits 2 coroner event add
stderr 'coroner event add --help'
exits 2 coroner event add 'Primary stepped down' --source 'DB-2 Mongod'
stderr 'Did you mean `db-2-mongod`\?'
exits 2 coroner event add 'Primary stepped down' --at '2026-03-08 02:30'
stderr 'America/New_York.*-05:00'
exits 2 coroner event add 'Primary stepped down' --tz ''
stderr '--tz must not be empty'
! exists $WORK/.local/share/coroner

# Add an event at an RFC 3339 time, and see it resolved in UTC and the local zone.
exec coroner timeline create mongo-outage
exec coroner timeline use mongo-outage
exec coroner event add 'Primary stepped down: replSetStepDown' --at 2026-09-11T03:14:07.412Z --source mongod --tag election
! stdout .
stderr '^Added event #1 to timeline `mongo-outage` at 2026-09-11T03:14:07\.412Z \(-04:00 local: 23:14:07\)$'

# - reads the text from stdin.
stdin slack.txt
exec coroner event add - --source slack --at 2026-09-11T03:15:00Z
stderr '^Added event #2 to timeline `mongo-outage`'

# --dry-run shows the event and adds nothing.
exec coroner event add 'Deploy started' --at 2026-09-11T14:00:00Z --dry-run
stdout '^Would add to timeline `mongo-outage` at 2026-09-11T14:00:00Z \(-04:00 local: 10:00:00\)$'

# The timeline lists both events in time order.
exec coroner timeline view
stdout '^Events: +2,'
stdout '^#1\t2026-09-11T03:14:07\.412000000Z\t\tmongod\tPrimary stepped down: replSetStepDown$'
stdout '^#2\t2026-09-11T03:15:00\.000000000Z\t\+52\.588s\tslack\tPager fires for db-2$'

-- slack.txt --
Pager fires for db-2
