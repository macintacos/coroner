# A command line rejected before it reaches the database never creates one.
exits 2 coroner event add
stderr 'coroner event add --help'
exits 2 coroner event add 'Primary stepped down' --source 'DB-2 Mongod'
stderr 'Did you mean `db-2-mongod`\?'
exits 2 coroner event add 'Primary stepped down' --at '2026-03-08 02:30'
stderr 'America/New_York.*-05:00'
exits 2 coroner event add 'Primary stepped down' --tz ''
stderr '--tz must not be empty'
! exists $WORK/.local/share/coroner

# Add an event at an RFC 3339 time, and see it resolved in UTC and the local zone.
exec coroner timeline create mongo-outage
exec coroner timeline use mongo-outage
exec coroner event add 'Primary stepped down: replSetStepDown' --at 2026-09-11T03:14:07.412Z --source mongod --tag election
! stdout .
stderr '^Added event #1 to timeline `mongo-outage` at 2026-09-11T03:14:07\.412Z \(-04:00 local: 23:14:07\)$'

# - reads the text from stdin.
stdin slack.txt
exec coroner event add - --source slack --at 2026-09-11T03:15:00Z
stderr '^Added event #2 to timeline `mongo-outage`'

# --dry-run shows the event and adds nothing.
exec coroner event add 'Deploy started' --at 2026-09-11T14:00:00Z --dry-run
stdout '^Would add to timeline `mongo-outage` at 2026-09-11T14:00:00Z \(-04:00 local: 10:00:00\)$'

# The timeline lists both events in time order, at their local time.
exec coroner timeline view
stdout '^Events: +2,'
stdout '^#1\t2026-09-10T23:14:07\.412-04:00\t\tmongod\tPrimary stepped down: replSetStepDown$'
stdout '^#2\t2026-09-10T23:15:00-04:00\t\+52\.588s\tslack\tPager fires for db-2$'

# Piped, event list prints one tab-separated row per event: seq, time, source, tags, text.
exec coroner event list --tag election
cmp stdout election.tsv

# --attach says what it copied, with the id to delete or export it by, before the event it added.
exec coroner event add 'Dashboard at peak' --at 2026-09-11T03:16:00Z --attach p99.gif
! stdout .
stderr '\AAttached p99\.gif as [0-9a-f-]{36} \(sha256 [0-9a-f]{8}…, 25 B, image/gif\)\nAdded event #3 '
exec coroner event add 'Dashboard at peak' --attach p99.gif --dry-run
stderr '^Would attach p99\.gif \(sha256 [0-9a-f]{8}…, 25 B, image/gif\)$'
exec coroner event edit 3 --attach p99.gif
stderr '\AAttached p99\.gif as [0-9a-f-]{36} .*\nEdited event #3 '

# Given -t more than once, event list merges the timelines by time and leads each row with
# its timeline.
exec coroner timeline create checkout-latency
exec coroner event add 'Checkout p99 at 4 s' --at 2026-09-11T03:14:30Z -t checkout-latency
exec coroner event list -t mongo-outage -t checkout-latency --until 2026-09-11T03:16:00Z
cmp stdout overlay.tsv

# A bad --tz fails only the commands that read or print times, and delete fails before deleting.
exec coroner status --tz Bogus/Zone
exec coroner timeline create gamma --tz Bogus/Zone --dry-run
exits 2 coroner event list --tz Bogus/Zone
stderr 'unknown time zone "Bogus/Zone" in --tz'
exits 2 coroner event delete 1 --tz Bogus/Zone
stderr 'unknown time zone "Bogus/Zone" in --tz'
exec coroner event view 1
stdout 'Primary stepped down'

# A day-precision event shows its own date, in the offset it was recorded in.
exec coroner timeline create release-day
exec coroner event add 'Release cut' --at 2026-09-11 --tz UTC -t release-day
exec coroner event list -t release-day --tz America/New_York
stdout '^#1\t2026-09-11T00:00:00Z\t'

-- p99.gif --
GIF89a p99 latency panel
-- slack.txt --
Pager fires for db-2
-- election.tsv --
#1	2026-09-10T23:14:07.412-04:00	mongod	election	Primary stepped down: replSetStepDown
-- overlay.tsv --
mongo-outage	#1	2026-09-10T23:14:07.412-04:00	mongod	election	Primary stepped down: replSetStepDown
checkout-latency	#1	2026-09-10T23:14:30-04:00	-	-	Checkout p99 at 4 s
mongo-outage	#2	2026-09-10T23:15:00-04:00	slack	-	Pager fires for db-2
