# A colleague commented on the HTML page of inc-4821.jsonl and exported their comments; the
# investigator, who has the timeline, previews the file and imports it. Both JSONL files
# are real: the first from timeline export, the second downloaded from that export's page.
env CORONER_DB=$WORK/investigator.db
exits 0 coroner import inc-4821.jsonl

exits 0 coroner import inc-4821-annotations-Priya-Shah.jsonl --dry-run --json
stdout '"annotations":\{"inserted":2,"identical":0,"conflicting":0\}'

exits 0 coroner import inc-4821-annotations-Priya-Shah.jsonl
stderr '^Imported annotations: 2 inserted, 0 identical, 0 conflicting$'

# The comments keep the IDs, author and times the page gave them.
exits 0 coroner annotation list -t inc-4821 --json
cmp stdout annotations.json

