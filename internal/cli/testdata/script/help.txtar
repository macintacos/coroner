# --help prints usage to stdout and exits 0.
exec coroner --help
cmp stdout help.txt
! stderr .

# An unknown flag exits non-zero and names the flag on stderr.
! exec coroner --no-such-flag
! stdout .
stderr 'unknown flag: --no-such-flag'

-- help.txt --
coroner CLI

Usage:
  coroner [flags]

Flags:
      --config string   path to the config file
      --db string       path to the database file
      --debug           print debug detail on stderr
      --format string   output format: text, json or jsonl (default "text")
  -h, --help            help for coroner
      --json            short for --format json
      --no-color        disable color
  -q, --quiet           print only essential output
      --tz string       time zone for times in this invocation
