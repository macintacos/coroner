#!/usr/bin/env bash
#MISE description="Build the docs site into site/, failing on any warning"
#MISE wait_for=["lint", "test"]

set -euo pipefail

# The wait matters under preflight: lint and test walk the tree through ./..., and fail when
# --clean deletes a directory under site/ mid-walk.

uv run --locked zensical build --clean --strict

# Zensical publishes only files under docs/, and a symlink there empties the build,
# so copy the generated schema in. Pages link it as /coroner/schema/: a relative
# link fails rumdl's MD057, since the copy exists only after this build.
mkdir -p site/schema
cp schema/*.json site/schema/

# Neither rumdl nor Zensical checks a root-absolute link. /coroner/ is site_url's path in
# zensical.toml; keep the two in sync.
rc=0
links=$(grep -roE 'href="/coroner/schema/[^"]+' site) || rc=$?
((rc <= 1)) || exit "$rc"
if [[ -z $links ]]; then
	echo "docs:build: no page links /coroner/schema/, so the schema link check inspected nothing" >&2
	exit 1
fi
while IFS= read -r link; do
	file=${link#*:href=\"/coroner/}
	test -f "site/${file}" || {
		printf 'docs:build: %s links /coroner/%s, which is not in site/\n' "${link%%:*}" "$file" >&2
		exit 1
	}
done <<<"$links"
