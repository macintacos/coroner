#!/usr/bin/env bash
#MISE description="Run the test suite"
#USAGE arg "[pkg]" help="Package pattern to test (default ./...)"
#USAGE flag "-f --focus <regexp>" help="Only run specs matching regexp"

set -euo pipefail

gotestsum --format testname -- "${usage_pkg:-./...}" ${usage_focus:+-ginkgo.focus="$usage_focus"}
