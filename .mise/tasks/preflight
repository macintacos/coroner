#!/usr/bin/env bash
#MISE description="Run the project's checks before pushing / opening a PR"
#MISE depends=["lint", "test", "build"]

set -euo pipefail

# Reaching here means every task in `depends` passed.
# A typo in .golangci.yml silently disables the rule it misspells.
golangci-lint config verify
echo "preflight: all checks passed"
